{
  "name": "ponto-digital-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "supabase:config": "node scripts/supabase-config.mjs",
    "modo:demo": "node scripts/supabase-config.mjs --demo",
    "modo:supabase": "node scripts/supabase-config.mjs --supabase",
    "publicacao:env": "node scripts/publicacao-env.mjs",
    "whatsapp:chave": "node -e \"console.log('WHATSAPP_TOKEN_KEY=' + require('crypto').randomBytes(32).toString('base64')); console.log('WHATSAPP_VERIFY_TOKEN=' + require('crypto').randomBytes(24).toString('base64url')); console.log('WAWEB_SESSION_KEY=' + require('crypto').randomBytes(32).toString('base64'))\"",
    "vercel:env": "node scripts/publicacao-env.mjs",
    "verificar:publicacao": "node scripts/verificar-publicacao.mjs",
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "node scripts/build.mjs",
    "build:webpack": "node scripts/build.mjs --webpack",
    "start": "next start",
    "css:build": "node scripts/build-css.mjs",
    "css:check": "node scripts/build-css.mjs --check",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:reset": "node -e \"require('fs').rmSync('.data/demo-db.json',{force:true});console.log('Base demo será recriada no próximo acesso.')\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "baileys": "7.0.0-rc14",
    "clsx": "^2.1.1",
    "geist": "^1.8.2",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "papaparse": "^5.7.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
