# ==========================================================================
# Ponto Digital CRM — variáveis de ambiente
# Copie para .env.local (ou rode `npm run setup`, que gera segredos aleatórios).
# NUNCA faça commit do .env.local. Em produção, cadastre estas variáveis no
# painel da hospedagem (ex.: Vercel → Settings → Environment Variables).
# ==========================================================================

# demo = dados demonstrativos locais (.data/demo-db.json) | supabase = banco real no Supabase
DATA_BACKEND=demo

# Segredo para assinar a sessão (mín. 32 caracteres aleatórios)
SESSION_SECRET=
APP_URL=http://localhost:3000

# Acesso de demonstração (usado apenas para criar a base demo)
DEMO_ADMIN_EMAIL=admin@pontodigital.demo
DEMO_ADMIN_PASSWORD=
DEMO_TEAM_PASSWORD=

# --- Supabase (configure com `npm run supabase:config`) ---
# Project Settings → API (ou "API Keys"): Project URL e a chave PUBLISHABLE (ou "anon").
# NUNCA coloque aqui a chave secreta (sb_secret_... / service_role): ela ignora a
# segurança do banco e não é usada nesta etapa. O CRM recusa iniciar se ela for usada.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- WhatsApp Cloud API oficial (Meta) — preencher só na etapa de integração ---
# simulacao = nada é enviado (padrão) | live = envia de verdade (exige autorização)
WHATSAPP_SEND_MODE=simulacao
# Trava extra para campanhas. Mantenha false até aprovação explícita.
WHATSAPP_CAMPAIGNS_LIVE=false
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# App Secret do app Meta: valida a assinatura X-Hub-Signature-256 dos webhooks
WHATSAPP_APP_SECRET=
# Token que você define e informa no painel da Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=
