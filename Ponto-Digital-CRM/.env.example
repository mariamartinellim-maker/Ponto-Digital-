# ==========================================================================
# Ponto Digital CRM — variáveis de ambiente
# Copie para .env.local (ou rode `npm run setup`, que gera segredos aleatórios).
# NUNCA faça commit do .env.local. Em produção, cadastre estas variáveis no
# painel da hospedagem (Render → seu serviço → Environment).
# ==========================================================================

# demo = dados demonstrativos locais (.data/demo-db.json) | supabase = banco real no Supabase
DATA_BACKEND=demo

# Segredo para assinar a sessão (mín. 32 caracteres aleatórios)
SESSION_SECRET=
APP_URL=http://localhost:3000

# Acesso de demonstração (usado apenas para criar a base demo)
DEMO_ADMIN_EMAIL=admin@pontodigital.demo
DEMO_ADMIN_PASSWORD=
DEMO_TEAM_PASSWORD=

# --- Supabase (configure com `npm run supabase:config`) ---
# Project Settings → API (ou "API Keys"): Project URL e a chave PUBLISHABLE (ou "anon").
# NUNCA coloque a chave secreta (sb_secret_... / service_role) neste campo: ela ignora a
# segurança do banco. O CRM recusa iniciar se ela for usada aqui.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Chave SECRETA — somente no servidor publicado (Render), nunca no computador nem no Git.
# Usada apenas para gravar as mensagens recebidas pelo webhook e convidar a equipe.
SUPABASE_SECRET_KEY=

# --- WhatsApp Cloud API oficial (Meta), em coexistência com o app WhatsApp Business ---
# simulacao = nada é enviado (padrão) | live = envia de verdade (exige autorização)
WHATSAPP_SEND_MODE=simulacao
# teste = envio real SOMENTE para os números abaixo | producao = clientes reais
WHATSAPP_AMBIENTE=teste
# Celulares da equipe para testes (com DDI e DDD, separados por vírgula). Ex.: 5511999990000,5511988880000
WHATSAPP_NUMEROS_TESTE=
# Trava extra para campanhas. Mantenha false até aprovação explícita.
WHATSAPP_CAMPAIGNS_LIVE=false
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# App Secret do app Meta: valida a assinatura X-Hub-Signature-256 dos webhooks
WHATSAPP_APP_SECRET=
# Token que você define e informa no painel da Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=
# Criptografa o token obtido na conexão por coexistência (gere com: npm run whatsapp:chave)
WHATSAPP_TOKEN_KEY=
# App da Meta e configuração do Embedded Signup (não são segredos)
META_APP_ID=
META_ES_CONFIG_ID=

# --- Assistente de IA (Claude, da Anthropic) — sem a chave, a IA fica desligada ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high (mais alto = respostas mais elaboradas e mais caras)
AI_ESFORCO=low
# Máximo de sugestões por mês para a organização inteira
AI_LIMITE_MENSAL=1000
